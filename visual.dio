                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ru9geXgE6EgMVzdhfRGu-60" value="8. Logout → Delete session" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="ru9geXgE6EgMVzdhfRGu-51" target="ru9geXgE6EgMVzdhfRGu-54">
                    <mxGeometry x="0.4973" y="1" relative="1" as="geometry">
                        <mxPoint x="290" y="210" as="sourcePoint"/>
                        <mxPoint x="310" y="270" as="targetPoint"/>
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ru9geXgE6EgMVzdhfRGu-61" value="&lt;b&gt;✓ Advantages:&lt;/b&gt;&#xa;• Can instantly invalidate sessions (logout, ban)&#xa;• Full control from backend (admin panel)&#xa;• Short-term sessions (banking: 10-15 min)&#xa;• No token theft worries (server validates)&#xa;&#xa;&lt;b&gt;✗ Disadvantages:&lt;/b&gt;&#xa;• Memory limitation (scalability issue)&#xa;• Not serverless-friendly (needs persistent state)&#xa;• Restart server → all users logged out&#xa;• Requires Redis for horizontal scaling" style="text;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="50" y="400" width="720" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="ru9geXgE6EgMVzdhfRGu-62" value="&lt;b&gt;STATELESS AUTHENTICATION (JWT Tokens)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=16;verticalAlign=top;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="830" y="90" width="720" height="550" as="geometry"/>
                </mxCell>
                <mxCell id="ru9geXgE6EgMVzdhfRGu-63" value="&lt;b&gt;User / Client&lt;/b&gt;" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
                    <mxGeometry x="850" y="160" width="40" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="ru9geXgE6EgMVzdhfRGu-64" value="1. Login (username/password)" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1" source="ru9geXgE6EgMVzdhfRGu-63" target="ru9geXgE6EgMVzdhfRGu-65">
                    <mxGeometry x="-0.485" y="12" relative="1" as="geometry">
