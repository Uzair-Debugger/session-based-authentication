                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ru9geXgE6EgMVzdhfRGu-56" value="4. Return session_id as cookie" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#d79b00;dashed=1;" edge="1" parent="1" source="ru9geXgE6EgMVzdhfRGu-51" target="ru9geXgE6EgMVzdhfRGu-49">
