                <mxCell id="ru9geXgE6EgMVzdhfRGu-54" value="&lt;b&gt;Session Store&lt;/b&gt;&#xa;(Redis / Server Memory)&#xa;&#xa;session_id → {&#xa;  user_id,&#xa;  role,&#xa;  name&#xa;}" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;fontFamily=monospace;fontSize=10;" vertex="1" parent="1">
                    <mxGeometry x="420" y="280" width="160" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="ru9geXgE6EgMVzdhfRGu-55" value="3. Create session ID &amp; store user data" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="ru9geXgE6EgMVzdhfRGu-51" target="ru9geXgE6EgMVzdhfRGu-54">
