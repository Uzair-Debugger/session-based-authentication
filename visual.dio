                <mxCell id="ru9geXgE6EgMVzdhfRGu-59" value="&lt;span style=&quot;background-color: rgb(255, 255, 0);&quot;&gt;7. Access resource (role-based)&lt;/span&gt;" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#FFFF00;entryX=0.47;entryY=0.71;entryDx=0;entryDy=0;entryPerimeter=0;edgeStyle=orthogonalEdgeStyle;" parent="1" source="ru9geXgE6EgMVzdhfRGu-51" target="ru9geXgE6EgMVzdhfRGu-49" edge="1">
