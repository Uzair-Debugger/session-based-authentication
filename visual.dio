                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ru9geXgE6EgMVzdhfRGu-58" value="6. Lookup session in store" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="ru9geXgE6EgMVzdhfRGu-51" target="ru9geXgE6EgMVzdhfRGu-54">
