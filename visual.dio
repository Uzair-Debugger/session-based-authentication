                </mxCell>
                <mxCell id="ru9geXgE6EgMVzdhfRGu-59" value="7. Access resource (role-based)" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="ru9geXgE6EgMVzdhfRGu-51" target="ru9geXgE6EgMVzdhfRGu-49">
                    <mxGeometry x="0.0153" y="49" relative="1" as="geometry">
                        <mxPoint x="330" y="210" as="sourcePoint"/>
