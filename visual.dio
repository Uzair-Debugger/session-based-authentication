                    </mxGeometry>
                </mxCell>
                <mxCell id="ru9geXgE6EgMVzdhfRGu-57" value="5. Subsequent request + session_id cookie" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1" source="ru9geXgE6EgMVzdhfRGu-49" target="ru9geXgE6EgMVzdhfRGu-51">
