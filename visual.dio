                <mxCell id="ru9geXgE6EgMVzdhfRGu-55" value="&lt;font style=&quot;background-color: rgb(0, 204, 204); color: rgb(0, 0, 0);&quot;&gt;3. Create session ID &amp;amp; store user data&lt;/font&gt;" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#00CCCC;dashed=1;" parent="1" source="ru9geXgE6EgMVzdhfRGu-51" target="ru9geXgE6EgMVzdhfRGu-54" edge="1">
