                </mxCell>
                <mxCell id="ru9geXgE6EgMVzdhfRGu-65" value="&lt;b&gt;Backend Server&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
                    <mxGeometry x="1320" y="140" width="120" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="ru9geXgE6EgMVzdhfRGu-66" value="2. Verify credentials" style="endArrow=classic;html=1;rounded=1;strokeWidth=2;strokeColor=#82b366;edgeStyle=orthogonalEdgeStyle;curved=0;" edge="1" parent="1" source="ru9geXgE6EgMVzdhfRGu-65" target="ru9geXgE6EgMVzdhfRGu-67">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1170" y="180" as="sourcePoint"/>
                        <mxPoint x="1250" y="180" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ru9geXgE6EgMVzdhfRGu-67" value="&lt;b&gt;Database&lt;/b&gt;&#xa;(Users table)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
                    <mxGeometry x="1460" y="250" width="80" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="ru9geXgE6EgMVzdhfRGu-68" value="&lt;b&gt;JWT Token Structure&lt;/b&gt;&#xa;Header + Payload + Signature&#xa;&#xa;Payload: {&#xa;  user_id: 123,&#xa;  name: &quot;John&quot;,&#xa;  role: &quot;user&quot;,&#xa;  exp: 1234567890&#xa;}" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;fontFamily=monospace;fontSize=10;" vertex="1" parent="1">
                    <mxGeometry x="1200" y="300" width="200" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="ru9geXgE6EgMVzdhfRGu-69" value="3. Create JWT signed with SECRET_KEY" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#b85450;dashed=1;" edge="1" parent="1" source="ru9geXgE6EgMVzdhfRGu-65" target="ru9geXgE6EgMVzdhfRGu-68">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1110" y="210" as="sourcePoint"/>
                        <mxPoint x="1110" y="270" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ru9geXgE6EgMVzdhfRGu-70" value="4. Return JWT token" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#d79b00;dashed=1;" edge="1" parent="1" source="ru9geXgE6EgMVzdhfRGu-65" target="ru9geXgE6EgMVzdhfRGu-63">
                    <mxGeometry x="-0.6329" y="-18" relative="1" as="geometry">
                        <mxPoint x="1050" y="210" as="sourcePoint"/>
                        <mxPoint x="910" y="210" as="targetPoint"/>
                        <mxPoint x="-1" as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ru9geXgE6EgMVzdhfRGu-71" value="&lt;b&gt;Frontend Storage&lt;/b&gt;&#xa;(LocalStorage / Cookie)&#xa;&#xa;Client stores token locally" style="shape=cloud;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="860" y="300" width="140" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="ru9geXgE6EgMVzdhfRGu-72" value="Store" style="endArrow=classic;html=1;rounded=0;strokeWidth=1;strokeColor=#666666;" edge="1" parent="1" source="ru9geXgE6EgMVzdhfRGu-63" target="ru9geXgE6EgMVzdhfRGu-71">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="890" y="230" as="sourcePoint"/>
                        <mxPoint x="940" y="290" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ru9geXgE6EgMVzdhfRGu-73" value="5. Subsequent request&#xa;+ Authorization: Bearer &lt;JWT&gt;" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1" source="ru9geXgE6EgMVzdhfRGu-63" target="ru9geXgE6EgMVzdhfRGu-65">
                    <mxGeometry x="-0.6377" y="-36" relative="1" as="geometry">
                        <mxPoint x="910" y="330" as="sourcePoint"/>
                        <mxPoint x="1050" y="330" as="targetPoint"/>
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ru9geXgE6EgMVzdhfRGu-74" value="6. Verify signature&#xa;with SECRET_KEY" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
                    <mxGeometry x="1290" y="360" width="120" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="ru9geXgE6EgMVzdhfRGu-75" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#82b366;" edge="1" parent="1" source="ru9geXgE6EgMVzdhfRGu-65" target="ru9geXgE6EgMVzdhfRGu-74">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1110" y="340" as="sourcePoint"/>
                        <mxPoint x="1130" y="340" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ru9geXgE6EgMVzdhfRGu-76" value="7. Extract user data from JWT&#xa;(No DB lookup needed)" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#82b366;dashed=1;" edge="1" parent="1" source="ru9geXgE6EgMVzdhfRGu-74" target="ru9geXgE6EgMVzdhfRGu-65">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1190" y="370" as="sourcePoint"/>
                        <mxPoint x="1170" y="210" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ru9geXgE6EgMVzdhfRGu-77" value="8. Access resource (based on JWT payload)" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#82b366;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="ru9geXgE6EgMVzdhfRGu-65" target="ru9geXgE6EgMVzdhfRGu-63">
                    <mxGeometry x="-0.1304" y="-30" relative="1" as="geometry">
                        <mxPoint x="1110" y="210" as="sourcePoint"/>
                        <mxPoint x="910" y="410" as="targetPoint"/>
                        <mxPoint as="offset"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="ru9geXgE6EgMVzdhfRGu-78" value="&lt;b&gt;✓ Advantages:&lt;/b&gt;&#xa;• No server memory usage (scales horizontally)&#xa;• Perfect for serverless architecture (AWS Lambda)&#xa;• Long-term sessions possible (30 days, Facebook)&#xa;• Fast — no DB lookup for each request&#xa;&#xa;&lt;b&gt;✗ Disadvantages:&lt;/b&gt;&#xa;• Cannot invalidate token easily (needs blacklist)&#xa;• Token theft is dangerous (hacker acts as user)&#xa;• Larger payload size (more bandwidth)&#xa;• Complex token refresh &amp; logout handling" style="text;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;" vertex="1" parent="1">
                    <mxGeometry x="830" y="450" width="720" height="190" as="geometry"/>
                </mxCell>
                <mxCell id="ru9geXgE6EgMVzdhfRGu-79" value="&lt;b&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;When to Use What? (Decision Guide)&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;verticalAlign=top;" vertex="1" parent="1">
                    <mxGeometry x="50" y="890" width="1500" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="ru9geXgE6EgMVzdhfRGu-80" value="&lt;b&gt;📌 Use Sessions (Stateful) when:&lt;/b&gt;&#xa;✓ Banking / financial apps (short sessions)&#xa;✓ Need instant logout / ban capability&#xa;✓ Strict compliance (GDPR, audit logs)&#xa;✓ Single server or Redis available&#xa;✓ Admin panel with session control" style="text;html=1;strokeColor=#6c8ebf;fillColor=#dae8fc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="90" y="930" width="440" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="ru9geXgE6EgMVzdhfRGu-81" value="&lt;b&gt;📌 Use JWT (Stateless) when:&lt;/b&gt;&#xa;✓ Microservices / Serverless architecture&#xa;✓ Mobile apps (no cookie dependency)&#xa;✓ Long-term sessions (social media, email)&#xa;✓ High scalability required&#xa;✓ Cross-domain / SSO scenarios" style="text;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="570" y="930" width="440" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="ru9geXgE6EgMVzdhfRGu-82" value="&lt;b&gt;📌 Hybrid Approach (Best of Both):&lt;/b&gt;&#xa;✓ JWT for authentication + Redis blacklist for logout&#xa;✓ Short-lived access token + refresh token&#xa;✓ Session store for sensitive operations only&#xa;✓ Use HttpOnly cookies for JWT storage (XSS protection)" style="text;html=1;strokeColor=#9673a6;fillColor=#e1d5e7;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=12;" vertex="1" parent="1">
                    <mxGeometry x="1050" y="930" width="480" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="ru9geXgE6EgMVzdhfRGu-83" value="&lt;b&gt;💡 Key Insight from Audio:&lt;/b&gt; Sessions store state on server (controllable but memory-heavy). JWT stores state on client (scalable but hard to invalidate). Choose based on your scalability needs and security requirements." style="text;html=1;strokeColor=#b85450;fillColor=#f8cecc;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1;" vertex="1" parent="1">
                    <mxGeometry x="50" y="1070" width="1500" height="50" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
