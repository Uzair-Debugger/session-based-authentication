                <mxCell id="ru9geXgE6EgMVzdhfRGu-54" value="&lt;b&gt;&lt;font style=&quot;font-size: 13px; color: rgb(0, 102, 102);&quot;&gt;Session Store&lt;/font&gt;&lt;/b&gt;&lt;br&gt;(Redis / Server Memory)&lt;br&gt;&lt;br&gt;session_id → {&lt;br&gt;&amp;nbsp; user_id,&lt;br&gt;&amp;nbsp; role,&lt;br&gt;&amp;nbsp; name&lt;br&gt;}" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;fontFamily=monospace;fontSize=10;" parent="1" vertex="1">
